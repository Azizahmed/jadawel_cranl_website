  "private": true,
  "description": "Bilingual Arabic-first marketing site for Jadawel (جداول), built to Jadawel Visual Identity v1.0.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "legal": "node tools/build-legal.mjs",
